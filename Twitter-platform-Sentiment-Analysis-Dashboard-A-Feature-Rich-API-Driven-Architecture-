    {
      "cell_type": "code",
      "source": [
        "import numpy as np\n",
        "import pandas as pd\n",
        "from sklearn.feature_extraction.text import TfidfVectorizer\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.linear_model import LogisticRegression\n",
        "from sklearn.naive_bayes import MultinomialNB\n",
        "from sklearn.svm import LinearSVC\n",
        "from sklearn.metrics import accuracy_score, classification_report, confusion_matrix\n",
        "\n",
        "# ==========================================\n",
        "# 1. FIXED DATA EXTRACTION & LABEL SANITIZATION\n",
        "# ==========================================\n",
        "# Drop missing rows\n",
        "df = df.dropna(subset=['Text', 'Sentiment'])\n",
        "\n",
        "# Create a clean deep copy to prevent layout slicing warnings\n",
        "df_clean = df.copy()\n",
        "\n",
        "# Fix the multi-line corruption: split by newline and take only the first element, then strip spaces\n",
        "df_clean['Sentiment'] = df_clean['Sentiment'].astype(str).apply(lambda x: x.split('\\n')[0].strip())\n",
        "\n",
        "# Clean the target class space: keep only the true 4 parameters required by your instructor\n",
        "valid_labels = ['Positive', 'Negative', 'Neutral', 'Irrelevant']\n",
        "df_clean = df_clean[df_clean['Sentiment'].isin(valid_labels)]\n",
        "\n",
        "# Drop records that became empty strings or gaps\n",
        "df_clean = df_clean.dropna(subset=['Cleaned_Text'])\n",
        "df_clean = df_clean[df_clean['Cleaned_Text'].str.strip() != '']\n",
        "\n",
        "print(\"--- Fixed Target Label Balance Matrix ---\")\n",
        "print(df_clean['Sentiment'].value_counts())\n",
        "print(\"-\" * 45 + \"\\n\")\n",
        "\n",
        "# ==========================================\n",
        "# 2. RUN VECTORIZATION PIPELINE AGAIN\n",
        "# ==========================================\n",
        "tfidf = TfidfVectorizer(max_features=5000, ngram_range=(1, 2))\n",
        "X_features = tfidf.fit_transform(df_clean['Cleaned_Text'])\n",
        "y_labels = df_clean['Sentiment'].values\n",
        "\n",
        "print(\"--- Data Extraction Validation ---\")\n",
        "print(f\"Clean Matrix Samples Available: {X_features.shape[0]}\\n\")\n",
        "\n",
        "# ==========================================\n",
        "# 3. SPLIT DATA INTO TRAINING & TESTING SETS\n",
        "# ==========================================\n",
        "X_train, X_test, y_train, y_test = train_test_split(\n",
        "    X_features, y_labels, test_size=0.2, random_state=42, stratify=y_labels\n",
        ")\n",
        "\n",
        "print(f\"Training Set Rows: {X_train.shape[0]}\")\n",
        "print(f\"Testing Set Rows: {X_test.shape[0]}\\n\")\n",
        "\n",
        "# ==========================================\n",
        "# 4. TRAIN AND EVALUATE PIPELINE LOOP\n",
        "# ==========================================\n",
        "models = {\n",
        "    \"Naive Bayes\": MultinomialNB(),\n",
        "    \"Logistic Regression\": LogisticRegression(max_iter=1000, random_state=42),\n",
        "    \"Linear Support Vector Machine\": LinearSVC(random_state=42)\n",
        "}\n",
        "\n",
        "best_accuracy = 0\n",
        "best_model_name = \"\"\n",
        "trained_models = {}\n",
        "\n",
        "for name, model in models.items():\n",
        "    print(f\"=== Training {name} ===\")\n",
        "    model.fit(X_train, y_train)\n",
        "    trained_models[name] = model\n",
        "\n",
        "    y_pred = model.predict(X_test)\n",
        "    acc = accuracy_score(y_test, y_pred)\n",
        "    print(f\"{name} Score: {acc:.4f}\\n\")\n",
        "\n",
        "    if acc > best_accuracy:\n",
        "        best_accuracy = acc\n",
        "        best_model_name = name\n",
        "\n",
        "# ==========================================\n",
        "# 5. MATRIX METRICS REPORT & CONFUSION MATRIX EVALUATION\n",
        "# ==========================================\n",
        "print(f\" CHAMPION PIPELINE VARIATION: {best_model_name}\")\n",
        "champion_predictions = trained_models[best_model_name].predict(X_test)\n",
        "print(classification_report(y_test, champion_predictions))\n",
        "\n",
        "print(\"\\n=== Confusion Matrix Grid ===\")\n",
        "cm = confusion_matrix(y_test, champion_predictions, labels=valid_labels)\n",
        "cm_df = pd.DataFrame(cm, index=[f\"Actual_{l}\" for l in valid_labels], columns=[f\"Predicted_{l}\" for l in valid_labels])\n",
        "print(cm_df)\n"
