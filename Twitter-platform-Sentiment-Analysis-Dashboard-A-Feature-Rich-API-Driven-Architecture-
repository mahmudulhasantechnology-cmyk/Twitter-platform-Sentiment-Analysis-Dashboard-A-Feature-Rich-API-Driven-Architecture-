      "source": [
        "import re\n",
        "import pandas as pd\n",
        "import nltk\n",
        "from nltk.tokenize import word_tokenize\n",
        "from nltk.corpus import stopwords\n",
        "\n",
        "# ==========================================\n",
        "# 1. DOWNLOAD REQUIRED NLTK RESOURCES\n",
        "# ==========================================\n",
        "nltk.download('punkt_tab')\n",
        "nltk.download('stopwords')\n",
        "\n",
        "# ==========================================\n",
        "# 2. DEFINE STATIC RESOURCES (ONCE)\n",
        "# ==========================================\n",
        "# Defining this outside the function prevents rebuilding it for every row\n",
        "stop_words = set(stopwords.words('english'))\n",
        "\n",
        "# Drop any rows where text data is completely missing\n",
        "df = df.dropna(subset=['Text'])\n",
        "\n",
        "# ==========================================\n",
        "# 3. DEFINE THE CLEANING FUNCTION\n",
        "# ==========================================\n",
        "def clean_text(text):\n",
        "    # Ensure input is a string\n",
        "    text = str(text)\n",
        "\n",
        "    # Feature A: Convert everything to lowercase\n",
        "    text = text.lower()\n",
        "\n",
        "    # Feature B: Handle and remove the <unk> text blocks explicitly\n",
        "    text = text.replace('<unk>', '')\n",
        "\n",
        "    # Feature C: Remove URLs/Links (often found in social posts)\n",
        "    text = re.sub(r'http\\S+|www\\S+|pic\\.twitter\\S+', '', text)\n",
        "\n",
        "    # Feature D: Remove tags and special characters (keeping only letters, numbers, and spaces)\n",
        "    text = re.sub(r'[^a-zA-Z0-9\\s]', '', text)\n",
        "\n",
        "    # Feature E: Tokenize (split the text into a list of individual words)\n",
        "    words = word_tokenize(text)\n",
        "\n",
        "    # Feature F: Filter out English stop words\n",
        "    cleaned_words = [word for word in words if word not in stop_words]\n",
        "\n",
        "    # Join the punchy fragments back into a single clean string sentence\n",
        "    return \" \".join(cleaned_words)\n",
        "\n",
        "# ==========================================\n",
        "# 4. RUN THE PIPELINE & REVIEW THE SPECIFICS\n",
        "# ==========================================\n",
        "# Apply the clean_text function over your specific text column\n",
        "df['Cleaned_Text'] = df['Text'].apply(clean_text)\n",
        "\n",
        "# Drop rows that became completely empty strings after removing stops and unk tags\n",
        "df = df[df['Cleaned_Text'] != '']\n",
        "\n",
        "# Output a comprehensive comparison grid to verify accuracy\n",
        "print(\"--- Check Data Preprocessing Results ---\")\n",
        "print(df[['Text', 'Cleaned_Text']].head(10))\n"
      ],
